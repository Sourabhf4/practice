pipeline {
    agent any

    stages {

        stage('Clone') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/Sourabhf4/student-app-k8s.git'
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('frontend') {
                    sh 'docker build -t frontendd:latest .'
                }
            }
        }

        stage('Run Container') {
            steps {
                sh '''
                    docker run -d --name frontendhkdbfcnwihgefvjud -P frontendd:latest
                '''
            }
        }
    }
}






